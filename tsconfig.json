{
  "compilerOptions": {
    /* Alvo de runtime: Node 24 já suporta tranquilamente ES2023 */
    "target": "ES2023",
    "lib": ["ES2023"],

    /* ESM nativo do Node. `NodeNext` faz o TS resolver módulos exatamente como
       o Node 24 resolve em runtime (campo `exports` dos pacotes, distinção
       entre .mts/.cts), então o que compila aqui é o que carrega lá.
       Consequência prática: todo import relativo exige a extensão `.js`,
       mesmo partindo de um arquivo `.ts`. */
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,

    "rootDir": "src",
    "outDir": "dist",
    "sourceMap": true,
    "declaration": false,

    /* Modo estrito completo — como o time comenta pouco o código,
       o compilador vira a documentação viva do formato dos objetos */
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "alwaysStrict": true,

    /* Extras que pegam bugs comuns de quem vem de JS puro */
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": true,

    "skipLibCheck": true,
    "isolatedModules": true,

    /* Nenhum import é apagado ou reescrito pelo compilador: o que está escrito
       no .ts é o que sai no .js. Obriga `import type` em import de tipo e
       impede que um `import x = require()` entre sem querer e quebre o ESM. */
    "verbatimModuleSyntax": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
