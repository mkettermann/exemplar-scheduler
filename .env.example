# Tabela completa das variáveis em docs/02-configuracao-de-ambiente.md

# Ambiente: development | qa | hml | production  (`test` é injetado pelo vitest)
NODE_ENV=development
PORT=3000

JOBS_ENABLED=true

# MSSQL - usado pelo lock distribuído dos jobs
DB_SERVER=CHANGE_ME
DB_PORT=1433
DB_NAME=CHANGE_ME
DB_USER=CHANGE_ME
DB_PASSWORD=CHANGE_ME
# Atenção: qualquer texto não vazio é lido como `true` (ver docs/02).
DB_ENCRYPT=true

# Teto de espera do readiness (GET /health/ready) pelo banco, em ms
HEALTH_DB_TIMEOUT_MS=3000

# Application Insights - connection string (ou iKey pura). Ausente = desligado.
# Ver docs/13-application-insights.md
# APPINSIGHTSKEY=InstrumentationKey=00000000-0000-0000-0000-000000000000;IngestionEndpoint=https://...

# apiKey do modelo src/jobs/example-envio/ - sai junto com o exemplo.
# Ver docs/12-exemplo-job-e-servico.md
# EXAMPLE_ENVIO_API_KEY=CHANGE_ME
