# Tabela completa das variáveis em docs/02-configuracao-de-ambiente.md

# Ambiente
NODE_ENV=development
PORT=3000

JOBS_ENABLED=true

# MSSQL — usado pelo lock distribuído dos jobs
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=scheduler
DB_USER=usuario
DB_PASSWORD=senha
# Atenção: qualquer texto não vazio é lido como `true` (ver docs/02).
DB_ENCRYPT=true

# Teto de espera do readiness (GET /health/ready) pelo banco, em ms
HEALTH_DB_TIMEOUT_MS=3000
