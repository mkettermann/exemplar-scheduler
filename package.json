{
  "name": "exemplar-scheduler",
  "version": "1.0.0",
  "description": "Serviço isolado de jobs agendados — não escala, réplica única.",
  "engines": {
    "node": ">=24.0.0"
  },
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint:md": "markdownlint-cli2"
  },
  "dependencies": {
    "applicationinsights": "^3.16.0",
    "fastify": "^5.1.0",
    "mssql": "^11.0.1",
    "node-schedule": "^2.1.1",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/mssql": "^9.1.5",
    "@types/node": "^24.13.6",
    "@types/node-schedule": "^2.1.7",
    "@vitest/coverage-v8": "^5.0.1",
    "ajv": "^8.20.0",
    "markdownlint-cli2": "^0.23.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^5.0.1",
    "yaml": "^2.9.1"
  }
}
